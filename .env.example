# Copy to `.env` and fill in. Never commit `.env`.

# ---- LLM (summaries, decisions, action items) ----
# Option A: OpenAI or any OpenAI-compatible server (Ollama, vLLM, Groq...)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
# LLM_BASE_URL=http://localhost:11434/v1     # e.g. Ollama (set LLM_API_KEY=ollama, LLM_MODEL=qwen2.5:7b)
# Option B: Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# LLM_API_KEY=sk-ant-...

# ---- Speech recognition ----
WHISPER_MODEL=openai/whisper-small
# WHISPER_LANGUAGE=vi        # leave empty for auto-detect

# ---- Diarization (pyannote needs a Hugging Face token + accepted model terms) ----
DIARIZE=true
HF_TOKEN=hf_...
# DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# ---- Embeddings / storage ----
EMBEDDING_MODEL=intfloat/multilingual-e5-small
DATA_DIR=data
# QDRANT_URL=http://localhost:6333   # omit to use embedded Qdrant in DATA_DIR/qdrant
# QDRANT_PATH=data/qdrant

# ---- Chunking (characters) ----
# CHUNK_MAX_CHARS=3500
# CHUNK_MIN_CHARS=600

# ---- API service ----
# API_KEY=change-me          # when set, clients must send `X-API-Key: change-me` (the Streamlit UI does it automatically)
# MAX_UPLOAD_MB=500
# LOG_LEVEL=INFO
